{
  "name": "@mednet/ui",
  "version": "0.1.1",
  "private": true,
  "description": "React-компоненты ЦНИИОИЗ: shadcn/ui (Base UI, стиль Maia) в теме бренда, логотип, шапка, подвал, каркасы страниц",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hpnssflw/mednet-kit.git",
    "directory": "packages/ui"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/styles.css",
    "src/brand.css",
    "src/shadcn-tailwind.css",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "imports": {
    "#components/*": {
      "mednet-source": "./src/components/*.tsx",
      "default": "./dist/components/*.js"
    },
    "#hooks/*": {
      "mednet-source": "./src/hooks/*.ts",
      "default": "./dist/hooks/*.js"
    },
    "#lib/*": {
      "mednet-source": "./src/lib/*.ts",
      "default": "./dist/lib/*.js"
    }
  },
  "exports": {
    "./styles.css": "./src/styles.css",
    "./utils": {
      "types": "./dist/lib/utils.d.ts",
      "default": "./dist/lib/utils.js"
    },
    "./*": {
      "types": "./dist/components/*.d.ts",
      "default": "./dist/components/*.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "vendor-css": "node scripts/vendor-shadcn-css.mjs"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.0"
  },
  "dependencies": {
    "@fontsource/montserrat": "^5.3.0",
    "@mednet/tokens": "workspace:*",
    "cn": "^0.4.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/node": "^4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "30.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "4.21.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4"
  }
}
