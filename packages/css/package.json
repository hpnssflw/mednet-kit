{
  "name": "@mednet/css",
  "version": "0.1.1",
  "description": "CSS для сайтов без React: компоненты Basecoat в теме ЦНИИОИЗ, шрифты, токены",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hpnssflw/mednet-kit.git",
    "directory": "packages/css"
  },
  "files": [
    "dist",
    "demo",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "style": "dist/mednet.css",
  "jsdelivr": "dist/mednet.min.css",
  "unpkg": "dist/mednet.min.css",
  "exports": {
    "./mednet.css": "./dist/mednet.css",
    "./mednet.min.css": "./dist/mednet.min.css",
    "./fonts.css": "./dist/fonts.css",
    "./mednet.js": "./dist/mednet.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@fontsource/montserrat": "^5.3.0",
    "@mednet/tokens": "workspace:*",
    "@tailwindcss/node": "^4.3.3",
    "@types/node": "^26.6.5",
    "basecoat-css": "1.0.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4"
  }
}
