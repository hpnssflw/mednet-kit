{
  "name": "@mednet/cli",
  "version": "2.2.1",
  "private": true,
  "description": "Локальная установка инструкций агентов и диагностика проектов mednet-kit",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hpnssflw/mednet-kit.git",
    "directory": "packages/cli"
  },
  "bin": {
    "mednet": "./dist/cli.mjs"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "agents",
    "llms.md",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "node scripts/check-dist.mjs"
  }
}
